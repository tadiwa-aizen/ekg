@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix ekgs: <https://eventkg.l3s.uni-hannover.de/schema/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ekgs:TextEvent rdfs:subClassOf sem:Event .
ekgs:MilitaryEvent rdfs:subClassOf sem:Event .
ekgs:PoliticalEvent rdfs:subClassOf sem:Event .
ekgs:CulturalEvent rdfs:subClassOf sem:Event .
sem:hasPlace rdfs:domain sem:Event ; rdfs:range sem:Place .
